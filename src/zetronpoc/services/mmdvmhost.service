[Unit]
Description=MMDVMHost (POCSAG via MQTT/RemoteControl)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=simple
# El wrapper espera a que el puerto del modulo MMDVM exista antes de lanzar
# MMDVM-Host. Asi el servicio queda "active" (no en loop "activating") aunque
# el modulo no este conectado al arrancar, y arranca solo al conectarlo.
ExecStart=/opt/zetronpoc/scripts/mmdvmhost-run.sh /opt/zetronpoc/mmdvm/MMDVM.ini
Restart=always
RestartSec=5
StandardOutput=append:/var/log/mmdvm/mmdvmhost.out.log
StandardError=append:/var/log/mmdvm/mmdvmhost.err.log

[Install]
WantedBy=multi-user.target